{
  "name": "akari",
  "version": "0.1.0",
  "private": true,
  "description": "ローカルLLM用デスクトップアプリとCLI",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "akari": "node apps/cli/dist/index.js",
    "test:sandbox": "pnpm -r build && node --test --experimental-strip-types packages/core/test/sandbox.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
